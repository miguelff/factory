{
  "name": "factory",
  "version": "0.0.0-dev",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.6",
  "scripts": {
    "build": "bun build ./src/main.ts --compile --outfile ./dist/factory",
    "build:release": "bun run ./scripts/build-release.ts",
    "check": "bun run typecheck && bun test",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.3.6",
    "typescript": "^5.9.3"
  }
}
